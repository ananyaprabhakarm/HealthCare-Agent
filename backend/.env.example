# --- Database ---
# Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./dev.db

# --- CORS ---
# Comma-separated list of allowed frontend origins. "*" allows all.
CORS_ORIGINS=*

# --- Auth ---
# Required. Secret used to sign session JWTs — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app will fail to start if this is unset.
JWT_SECRET=

# --- LLM (Google Gemini) ---
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash

# --- Google Calendar (optional) ---
# Path to a service-account JSON file, or the JSON credentials themselves as a string.
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_DEFAULT_ID=primary

# --- Email (optional) ---
# Provider: "sendgrid", "gmail", or "smtp". Leave blank to disable email sending.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=

# Used when EMAIL_PROVIDER=sendgrid (SendGrid API key) or EMAIL_PROVIDER=gmail
# (Gmail service-account JSON credentials as a string).
EMAIL_API_KEY=

# Used when EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Notifications (optional) ---
# Provider: e.g. "slack" or "twilio". Leave blank to disable notifications.
NOTIFICATION_PROVIDER=

# Used when sending to the "slack" channel
SLACK_WEBHOOK_URL=

# Used when sending to the "whatsapp" channel via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Used when sending to the "whatsapp" channel via a generic API instead of Twilio
WHATSAPP_API_KEY=
